# Local environment for svelte-web-frontend.
# Copy to src/env/.env (gitignored) and fill in what your workflow needs.
# Production does not read this file: Vercel builds from its own project env vars.

# --- LLM coaching feedback (server-only) ---
ANTHROPIC_API_KEY=""

# --- Supabase the app talks to (default: local Docker stack) ---
# Values come from `pnpm supabase status` after `pnpm supabase start`.
# NEXT_PUBLIC_ values are exposed to the browser; the publishable/anon key is safe there (RLS applies).
NEXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""   # publishable key (sb_publishable_...) or legacy anon key

# Secret key for local admin scripts and for sync scripts run without --production.
# Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""       # secret key (sb_secret_...) or legacy service_role key

# --- Hosted Supabase, used by sync scripts run with --production ---
# e.g. node ./scripts/syncStorageAssets.js --production --dry-run
# (syncStorageAssets, syncStorageAssetsPortable, syncBundleData)
PRODUCTION_SUPABASE_URL="https://ngjnwvcgmfxwbwbidtcy.supabase.co"
PRODUCTION_SUPABASE_SERVICE_ROLE_KEY=""  # hosted secret key (sb_secret_...)

# --- Optional: run the dev server against hosted Supabase instead of Docker ---
# Create src/env/.env.remote (gitignored) with the hosted values below, then run `pnpm dev:remote`.
# Values in .env.remote override this file.
#   NEXT_PUBLIC_SUPABASE_URL="https://ngjnwvcgmfxwbwbidtcy.supabase.co"
#   NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
