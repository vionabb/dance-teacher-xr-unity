# Hosted Supabase (the same project production uses).
# Copy to src/env/.env.remote (gitignored) and fill in the values.
# Used by:
#   pnpm dev:remote                                  run the dev server against hosted Supabase
#   node ./scripts/syncStorageAssets.js --production upload assets (also syncStorageAssetsPortable,
#                                                    syncBundleData); add --dry-run to preview
# ANTHROPIC_API_KEY is read from .env.local.

NEXT_PUBLIC_SUPABASE_URL="https://ngjnwvcgmfxwbwbidtcy.supabase.co"
# Publishable key (sb_publishable_...) from Supabase > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Secret key (sb_secret_...). Only needed for --production sync scripts. Keep it out of the browser.
SUPABASE_SERVICE_ROLE_KEY=""
