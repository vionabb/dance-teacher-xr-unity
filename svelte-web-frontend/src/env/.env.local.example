# Local development against the Docker Supabase stack.
# Copy to src/env/.env.local (gitignored) and fill in the values.
# Production does not read this file: Vercel builds from its own project env vars.
#
# Vite loads .env.local in every mode, so `pnpm dev:remote` still picks up
# ANTHROPIC_API_KEY from here; values in .env.remote override the rest.

# --- LLM coaching feedback (server-only) ---
ANTHROPIC_API_KEY=""

# --- Local Supabase (values from `pnpm supabase status` after `pnpm supabase start`) ---
NEXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
# Publishable key (sb_publishable_...) or legacy anon key. Exposed to the browser; RLS applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Secret key (sb_secret_...) or legacy service_role key. Used by sync scripts run without
# --production. Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""
