{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Reference Pipeline (smoke)",
            "type": "debugpy",
            "request": "launch",
            "module": "motion_extraction.dancetree.run_dancetree_pipeline",
            "args": [
                "--database_csv_path=${workspaceFolder}/temp/vscode_smoketest/db.csv",
                "--video_srcdir=${workspaceFolder}/../data/test-fixtures/smoketest/motionvideo",
                "--holistic_data_srcdir=${workspaceFolder}/temp/vscode_smoketest/holistic_data",
                "--pose2d_data_srcdir=${workspaceFolder}/temp/vscode_smoketest/pose2d_data",
                "--temp_dir=${workspaceFolder}/temp/vscode_smoketest/pipeline",
                "--bundle_export_path=${workspaceFolder}/temp/vscode_smoketest/bundle/nonmedia",
                "--bundle_media_export_path=${workspaceFolder}/temp/vscode_smoketest/bundle/media",
                "--include_audio_in_bundle",
                "--visibility_mode=interpolate",
                "--suppress_update_database_artifacts",
                "--suppress_compute_holistic_data_artifacts",
                "--suppress_preprocess_pose_data_artifacts",
                "--suppress_cumulative_complexity_artifacts",
                "--suppress_audio_analysis_artifacts",
                "--suppress_add_complexity_artifacts",
                "--suppress_bundle_data_artifacts"
            ]
        },
        {
            "name": "Run Participant Pose Pipeline",
            "type": "debugpy",
            "request": "launch",
            "module": "motion_extraction.study_pose_data",
            "args": [
                "--study=study1-segmented",
                "--data-root=${workspaceFolder}/../data/participant_motions"
            ]
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Extract Raw Pose Data (smoke)",
            "type": "debugpy",
            "request": "launch",
            "module": "motion_extraction.extract_holistic_data",
            "justMyCode": true,
            "args": [
                "--video_folder=${workspaceFolder}/../data/test-fixtures/smoketest/motionvideo",
                "--output_folder=${workspaceFolder}/temp/vscode_smoketest/holistic_data",
                "--pose2d_output_folder=${workspaceFolder}/temp/vscode_smoketest/pose2d_data",
                "--model-complexity=2",
                "--frame_output_folder=${workspaceFolder}/temp/vscode_smoketest/frames",
                "--debug_frame_whitelist=*",
                "--rewrite_existing"
            ]
        },
        {
            "name": "Preprocess Holistic Data (smoke)",
            "type": "debugpy",
            "request": "launch",
            "module": "motion_extraction.preprocess_pose_data",
            "justMyCode": true,
            "args": [
                "--pose_data_root=${workspaceFolder}/temp/vscode_smoketest/holistic_data",
                "--pose_data_type=holistic_3d",
                "--rewrite_existing"
            ]
        },
        {
            "name": "Preprocess Pose2D Data (smoke)",
            "type": "debugpy",
            "request": "launch",
            "module": "motion_extraction.preprocess_pose_data",
            "justMyCode": true,
            "args": [
                "--pose_data_root=${workspaceFolder}/temp/vscode_smoketest/pose2d_data",
                "--pose_data_type=pose2d",
                "--rewrite_existing"
            ]
        },
        {
            "name": "Audio Analysis (smoke)",
            "type": "debugpy",
            "request": "launch",
            "module": "motion_extraction.audio_analysis",
            "args": [
                "--videosrcdir=${workspaceFolder}/../data/test-fixtures/smoketest/motionvideo",
                "--destdir=${workspaceFolder}/temp/vscode_smoketest/audio_analysis",
                "--analysis_summary_out=${workspaceFolder}/temp/vscode_smoketest/audio_analysis/audio_analysis_summary.csv",
                "--audiocachedir=${workspaceFolder}/temp/vscode_smoketest/audio_cache",
                "--skip_existing"
            ]
        },
        {
            "name": "Update Database (smoke)",
            "type": "debugpy",
            "request": "launch",
            "module": "motion_extraction.update_database",
            "args": [
                "--videos_dir=${workspaceFolder}/../data/test-fixtures/smoketest/motionvideo",
                "--thumbnails_dir=${workspaceFolder}/temp/vscode_smoketest/thumbnails",
                "--database_csv_path=${workspaceFolder}/temp/vscode_smoketest/db.csv"
            ]
        }
    ]
}
